<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Matoshree Mobile | Repairing & Accessories</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:Arial, sans-serif;
  scroll-behavior:smooth;
}

body{
  background:#f5f7fb;
  color:#111827;
}

/* NAVBAR */
nav{
  background:#0b1220;
  padding:15px 6%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  position:sticky;
  top:0;
  z-index:1000;
}

.logo{
  display:flex;
  align-items:center;
  gap:10px;
  color:white;
  font-size:20px;
  font-weight:bold;
}

.logo-icon{
  width:42px;
  height:42px;
  background:#22c55e;
  border-radius:12px;
  display:flex;
  justify-content:center;
  align-items:center;
  font-size:23px;
}

.logo span{
  color:#22c55e;
}

.menu a{
  color:white;
  text-decoration:none;
  margin-left:20px;
  font-size:14px;
}

.menu a:hover{
  color:#22c55e;
}

/* HERO */
.hero{
  min-height:88vh;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:40px 6%;
  background:linear-gradient(135deg,#07111f,#12345b);
  color:white;
}

.hero-logo{
  width:90px;
  height:90px;
  margin:0 auto 22px;
  border-radius:25px;
  background:#22c55e;
  display:flex;
  justify-content:center;
  align-items:center;
  font-size:50px;
  box-shadow:0 10px 35px rgba(0,0,0,.3);
}

.hero h1{
  font-size:48px;
  margin-bottom:12px;
}

.hero h1 span{
  color:#22c55e;
}

.hero h2{
  font-size:23px;
  margin-bottom:18px;
  font-weight:normal;
}

.hero p{
  max-width:650px;
  margin:auto;
  line-height:1.7;
  color:#dbeafe;
  font-size:17px;
}

.buttons{
  margin-top:30px;
}

.btn{
  display:inline-block;
  padding:14px 24px;
  margin:6px;
  border-radius:30px;
  text-decoration:none;
  font-weight:bold;
  background:#22c55e;
  color:#052e16;
  transition:.3s;
}

.btn:hover{
  transform:translateY(-3px);
  background:white;
}

.btn-call{
  background:white;
  color:#111827;
}

/* SECTIONS */
section{
  padding:70px 6%;
}

.title{
  text-align:center;
  margin-bottom:40px;
}

.title h2{
  font-size:34px;
  margin-bottom:10px;
}

.title p{
  color:#6b7280;
}

/* SERVICES */
.cards{
  max-width:1100px;
  margin:auto;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:22px;
}

.card{
  background:white;
  padding:30px 20px;
  text-align:center;
  border-radius:20px;
  box-shadow:0 8px 25px rgba(0,0,0,.07);
  transition:.3s;
}

.card:hover{
  transform:translateY(-7px);
}

.card .icon{
  font-size:42px;
  margin-bottom:15px;
}

.card h3{
  font-size:20px;
  margin-bottom:10px;
}

.card p{
  color:#6b7280;
  line-height:1.6;
}

/* ABOUT */
.about{
  background:white;
}

.about-content{
  max-width:850px;
  margin:auto;
  text-align:center;
  line-height:1.8;
  color:#4b5563;
  font-size:17px;
}

/* WHY */
.why{
  background:#eefbf3;
}

.why-grid{
  max-width:850px;
  margin:auto;
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:18px;
}

.why-box{
  background:white;
  padding:22px;
  border-radius:15px;
  font-weight:bold;
  box-shadow:0 5px 15px rgba(0,0,0,.05);
}

/* CONTACT */
.contact{
  background:#0b1220;
  color:white;
  text-align:center;
}

.contact h2{
  font-size:32px;
  margin-bottom:15px;
}

.contact p{
  color:#d1d5db;
  margin:10px;
}

.phone{
  font-size:24px;
  color:#22c55e;
  font-weight:bold;
  margin:18px 0;
}

/* FOOTER */
footer{
  background:#050914;
  color:#9ca3af;
  text-align:center;
  padding:25px 15px;
  font-size:14px;
}

/* MOBILE */
@media(max-width:768px){

  .menu{
    display:none;
  }

  .hero{
    min-height:82vh;
  }

  .hero h1{
    font-size:36px;
  }

  .hero h2{
    font-size:19px;
  }

  .hero p{
    font-size:15px;
  }

  .cards{
    grid-template-columns:1fr;
  }

  .why-grid{
    grid-template-columns:1fr;
  }

  section{
    padding:55px 5%;
  }

  .title h2{
    font-size:28px;
  }
}
</style>
</head>

