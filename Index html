<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Matoshree Mobile | Repairing & Accessories</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f6f7fb;
      color: #151515;
    }

    /* NAVBAR */
    nav {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: #111827;
      padding: 16px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 3px 15px rgba(0,0,0,0.15);
    }

    .logo {
      color: white;
      font-size: 21px;
      font-weight: bold;
    }

    .logo span {
      color: #38bdf8;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 20px;
      font-size: 14px;
    }

    nav a:hover {
      color: #38bdf8;
    }

    /* HERO */
    .hero {
      min-height: 90vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 50px 7%;
      background: linear-gradient(135deg, #0f172a, #1e3a8a);
      color: white;
    }

    .hero-content {
      max-width: 800px;
    }

    .hero h1 {
      font-size: 48px;
      margin-bottom: 18px;
    }

    .hero h1 span {
      color: #38bdf8;
    }

    .hero p {
      font-size: 19px;
      line-height: 1.7;
      color: #e5e7eb;
      margin-bottom: 30px;
    }

    .btn {
      display: inline-block;
      padding: 14px 25px;
      border-radius: 30px;
      background: #38bdf8;
      color: #082f49;
      text-decoration: none;
      font-weight: bold;
      margin: 6px;
      transition: 0.3s;
    }

    .btn:hover {
      transform: translateY(-3px);
      background: white;
    }

    .btn-outline {
      background: transparent;
      color: white;
      border: 1px solid white;
    }

    /* COMMON */
    section {
      padding: 70px 7%;
    }

    .title {
      text-align: center;
      margin-bottom: 45px;
    }

    .title h2 {
      font-size: 34px;
      margin-bottom: 10px;
    }

    .title p {
      color: #666;
    }

    /* SERVICES */
    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .card {
      background: white;
      padding: 30px 22px;
      border-radius: 18px;
      text-align: center;
      box-shadow: 0 8px 25px rgba(0,0,0,0.07);
      transition: 0.3s;
    }

    .card:hover {
      transform: translateY(-7px);
    }

    .icon {
      font-size: 42px;
      margin-bottom: 18px;
    }

    .card h3 {
      margin-bottom: 10px;
      font-size: 21px;
    }

    .card p {
      color: #666;
      line-height: 1.6;
    }

    /* ABOUT */
    .about {
      background: white;
    }

    .about-box {
      max-width: 850px;
      margin: auto;
      text-align: center;
      line-height: 1.8;
      color: #555;
      font-size: 17px;
    }

    /* WHY US */
    .why {
      background: #eef6ff;
    }

    .why-list {
      max-width: 850px;
      margin: auto;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }

    .why-item {
      background: white;
      padding: 22px;
      border-radius: 15px;
      font-weight: bold;
      box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }

    /* CONTACT */
    .contact-box {
      max-width: 750px;
      margin: auto;
      background: #111827;
      color: white;
      padding: 40px 25px;
      border-radius: 22px;
      text-align: center;
    }

    .contact-box h2 {
      margin-bottom: 15px;
      font-size: 30px;
    }

    .contact-box p {
      color: #d1d5db;
      margin: 10px 0;
    }

    /* FOOTER */
    footer {
      background: #0b1120;
      color: #aaa;
      text-align: center;
      padding: 25px 15px;
      font-size: 14px;
    }

    /* MOBILE */
    @media (max-width: 768px) {

      nav {
        padding: 15px 5%;
      }

      nav .menu {
        display: none;
      }

      .hero {
        min-height: 80vh;
      }

      .hero h1 {
        font-size: 35px;
      }

      .hero p {
        font-size: 16px;
      }

      .cards {
        grid-template-columns: 1fr;
      }

      .why-list {
        grid-template-columns: 1fr;
      }

      section {
        padding: 55px 5%;
      }

      .title h2 {
        font-size: 28px;
      }
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->
  <nav>
    <div class="logo">
      Matoshree <span>Mobile</span>
    </div>

    <div class="menu">
      <a href="#home">Home</a>
      <a href="#services">Services</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </div>
  </nav>


  <!-- HERO -->
  <section class="hero" id="home">

    <div class="hero-content">

      <h1>
        Matoshree <span>Mobile</span>
      </h1>

      <p>
        Professional Mobile Repairing & Accessories
      </p>

      <p>
        Reliable service for your smartphone needs.
        Quality accessories and expert mobile repair solutions.
      </p>

      <a href="#services" class="btn">
        Explore Services
      </a>

      <a href="#contact" class="btn btn-outline">
        Visit Store
      </a>

    </div>

  </section>


  <!-- SERVICES -->
  <section id="services">

    <div class="title">
      <h2>Our Services</h2>
      <p>Complete solutions for your mobile needs</p>
    </div>

    <div class="cards">

      <div class="card">
        <div class="icon">🛠️</div>
        <h3>Mobile Repairing</h3>
        <p>
          Professional repair solutions for different mobile problems.
        </p>
      </div>

      <div class="card">
        <div class="icon">🔋</div>
        <h3>Battery Replacement</h3>
        <p>
          Battery replacement and related mobile services.
        </p>
      </div>

      <div class="card">
        <div class="icon">📱</div>
        <h3>Mobile Accessories</h3>
        <p>
          Useful accessories for your smartphone and daily needs.
        </p>
      </div>

      <div class="card">
        <div class="icon">🔌</div>
        <h3>Chargers & Cables</h3>
        <p>
          Chargers, cables and other mobile essentials.
        </p>
      </div>

      <div class="card">
        <div class="icon">🎧</div>
        <h3>Earphones</h3>
        <p>
          Different types of earphones and audio accessories.
        </p>
      </div>

      <div class="card">
        <div class="icon">🛡️</div>
        <h3>Screen Protection</h3>
        <p>
          Screen protection and other smartphone accessories.
        </p>
      </div>

    </div>

  </section>


  <!-- ABOUT -->
  <section class="about" id="about">

    <div class="title">
      <h2>About Matoshree Mobile</h2>
      <p>Your local mobile service destination</p>
    </div>

    <div class="about-box">

      <p>
        Matoshree Mobile is a local mobile repairing and accessories
        store dedicated to providing convenient solutions for your
        smartphone needs.
      </p>

      <br>

      <p>
        From mobile repairs to everyday accessories, customers can
        find useful mobile-related services under one roof.
      </p>

    </div>

  </section>


  <!-- WHY CHOOSE US -->
  <section class="why">

    <div class="title">
      <h2>Why Choose Us?</h2>
      <p>Simple, reliable and convenient service</p>
    </div>

    <div class="why-list">

      <div class="why-item">
        ✓ Professional Mobile Services
      </div>

      <div class="why-item">
        ✓ Quality Accessories
      </div>

      <div class="why-item">
        ✓ Convenient Local Service
      </div>

      <div class="why-item">
        ✓ Customer-Focused Approach
      </div>

    </div>

  </section>


  <!-- CONTACT -->
  <section id="contact">

    <div class="contact-box">

      <h2>Visit Matoshree Mobile</h2>

      <p>
        📍 Shop Location
      </p>

      <p>
        Location details will be added
      </p>

      <p>
        📞 Contact Number
      </p>

      <p>
        Contact details will be added
      </p>

      <br>

      <a href="#" class="btn">
        Contact Us
      </a>

    </div>

  </section>


  <!-- FOOTER -->
  <footer>

    <p>
      © 2026 Matoshree Mobile. Demo Website.
    </p>

    <p>
      Mobile Repairing & Accessories
    </p>

  </footer>

</body>
</html>
